{
  "name": "obuild",
  "version": "0.4.45",
  "description": "Zero-config ESM/TS package builder",
  "license": "MIT",
  "repository": "unjs/obuild",
  "bin": {
    "obuild": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./config": "./dist/config.mjs"
  },
  "scripts": {
    "build": "pnpm obuild",
    "dev": "pnpm vitest",
    "lint": "oxlint . && oxfmt --check",
    "fmt": "automd && oxlint . --fix && oxfmt",
    "obuild": "node ./src/cli.ts",
    "release": "pnpm test && pnpm build && changelogen --release && pnpm publish && git push --follow-tags",
    "test": "pnpm lint && pnpm test:types && pnpm vitest run --coverage",
    "test:types": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "c12": "4.0.0-rc.4",
    "consola": "^3.4.2",
    "defu": "^6.1.7",
    "exsolve": "^1.2.0",
    "magic-string": "^1.4.5",
    "nf3": "^0.4.2",
    "pathe": "^2.0.3",
    "rolldown": "^1.2.15",
    "rolldown-plugin-dts": "^0.28.8",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "automd": "^0.4.3",
    "changelogen": "^0.6.2",
    "eslint-config-unjs": "^0.6.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.28.9"
}
